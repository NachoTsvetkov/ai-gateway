COMPANY_NAME="Your Name"
SITE_NAME="Your Name – Portfolio"
SHOPIFY_REVALIDATION_SECRET=""
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
SHOPIFY_STORE_DOMAIN="[your-shopify-store-subdomain].myshopify.com"
AI_GATEWAY_API_KEY=""

# ---------------------------------------------------------------------
# PayPal — payments + subscriptions
# ---------------------------------------------------------------------
# Sandbox vs live. Default to "sandbox" so a misconfigured deploy can
# never accidentally take real money. Flip to "live" only after testing.
PAYPAL_ENV="sandbox"

# REST app credentials. Get them from
#   https://developer.paypal.com/dashboard/applications/sandbox  (sandbox)
#   https://developer.paypal.com/dashboard/applications/live     (live)
# Create one app per environment; client id + secret never cross envs.
PAYPAL_CLIENT_ID=""
PAYPAL_SECRET=""

# Public client id, exposed to the browser via the PayPal JS SDK. This
# is fine to ship — it's the same value PayPal embeds in the buttons
# anyway. SAFE to share. The matching secret above stays server-only.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""

# ---------------------------------------------------------------------
# Meta Pixel + Conversions API
# ---------------------------------------------------------------------
# All three vars are optional — the integration boots into a clean
# no-op state when they're missing (no script loaded, banner still
# shows so the consent choice is recorded for any future tracker).
#
# Setup:
#   1. Create a Pixel in Events Manager:
#        https://business.facebook.com/events_manager2/list/pixel
#      Copy the Pixel ID (a numeric string).
#   2. From the same Pixel, open Settings → Conversions API → Generate
#      access token. Copy that token (long opaque string).
#   3. Drop both into .env.local. NEXT_PUBLIC_FB_PIXEL_ID is the same
#      numeric id; it's safe to ship to the browser.
NEXT_PUBLIC_FB_PIXEL_ID="1001241555672445"
FB_PIXEL_ID="1001241555672445"
FB_CAPI_ACCESS_TOKEN=""

# Optional. When set, every CAPI event is tagged with this code so it
# shows up in Events Manager → your Pixel → Test Events tab in real
# time instead of counting toward production. Get the code from that
# tab (looks like "TESTxxxxx"). LEAVE UNSET ON PRODUCTION — keeping
# it set in Vercel would dump every visitor's events into the test
# bucket and mute the real dashboards.
# FB_CAPI_TEST_EVENT_CODE=""

# ---------------------------------------------------------------------
# Local-dev geo override (development only)
# ---------------------------------------------------------------------
# Forces server-side locale + currency + language-toggle visibility to
# behave as if the visitor's IP resolved to this 2-letter ISO-3166
# country code. Useful when localhost has no geo header.
#   "BG" → Bulgarian locale, EUR pricing, language toggle visible
#   "US" → English locale,    USD pricing, no toggle
# Ignored when NODE_ENV=production.
# DEV_COUNTRY="BG"

# ---------------------------------------------------------------------
# Firebase (for Personalized AI Opportunity Report / audit survey data collection)
# ---------------------------------------------------------------------
# Public config - safe to expose in client bundle.
# Get from Firebase Console > Project settings > General > Your apps > Web app config.
# Use the exact values provided (do not commit real keys to git - put in .env.local).
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyB7T_UgUR99QOzF4HZb98X98UUhKAnTwkk"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="nachotsvetkov-cbaa7.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="nachotsvetkov-cbaa7"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="nachotsvetkov-cbaa7.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="550961907742"
NEXT_PUBLIC_FIREBASE_APP_ID="1:550961907742:web:b4b28f53dcd7673bb6460f"

# For production, set these in Vercel (or your host) as well.
# Security: Rely on Firestore Security Rules (see firestore.rules in repo root + lib/firebase.ts).
# You MUST create the DB in console first (see scripts/test-chaos-firebase.ts for exact link + instructions).
# After DB exists: paste/deploy the rules from firestore.rules (or console editor).

# ---------------------------------------------------------------------
# Desktop monitor sync (GrokFirebaseReportMonitor — prod read proxy)
# ---------------------------------------------------------------------
# Prod Firestore rules block public reads on survey_responses / orders.
# The desktop app calls GET /api/desktop-data with this shared secret;
# the route uses Firebase Admin SDK server-side.
#
# Generate once: openssl rand -hex 32  (or any long random string)
DESKTOP_SYNC_SECRET=""

# Firebase Admin credentials for /api/desktop-data (pick one):
# - Path to service account JSON (default: ../../tools/GrokFirebaseReportMonitor/firebase-service-account.json from site root)
# FIREBASE_SERVICE_ACCOUNT_PATH=""
# - Or inline JSON (useful on Vercel — paste full JSON as one line)
# FIREBASE_SERVICE_ACCOUNT_JSON=""

# Optional: base URL the desktop app calls (defaults to http://127.0.0.1:3000 locally)
# DESKTOP_API_BASE_URL="https://your-production-domain.com"

# ---------------------------------------------------------------------
# Report generation + Gmail delivery (desktop semi-auto flow)
# ---------------------------------------------------------------------
# AI Gateway — used by POST /api/desktop/generate-report (same key as sales assistant).
# AI_GATEWAY_API_KEY is already documented above if present; required for website report generation.

# Gmail SMTP (simple setup) — used by POST /api/desktop/send-report
# 1. Enable 2-Step Verification on your Google account
# 2. Google Account → Security → App passwords → create one for "Mail"
# 3. Paste the 16-character password below (spaces optional)
# GMAIL_SMTP_USER="nacho.tsvetkov@gmail.com"
# GMAIL_SMTP_APP_PASSWORD="xxxx xxxx xxxx xxxx"
# GMAIL_FROM_EMAIL="nacho.tsvetkov@gmail.com"
# GMAIL_FROM_NAME="Nacho Tsvetkov"
# Optional overrides (defaults: smtp.gmail.com:587 TLS):
# GMAIL_SMTP_HOST="smtp.gmail.com"
# GMAIL_SMTP_PORT="587"
# GMAIL_SMTP_SECURE="false"

# Local only: allow sending reports for placeholder/test surveys (desktop sets forceSend when appsettings AllowPlaceholderReportSend=true)
# ALLOW_PLACEHOLDER_REPORT_SEND="true"

