COMPANY_NAME="Your Name"
SITE_NAME="Your Name – Portfolio"
SHOPIFY_REVALIDATION_SECRET=""
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
SHOPIFY_STORE_DOMAIN="[your-shopify-store-subdomain].myshopify.com"
AI_GATEWAY_API_KEY=""

# ---------------------------------------------------------------------
# PayPal — payments + subscriptions
# ---------------------------------------------------------------------
# Sandbox vs live. Default to "sandbox" so a misconfigured deploy can
# never accidentally take real money. Flip to "live" only after testing.
PAYPAL_ENV="sandbox"

# REST app credentials. Get them from
#   https://developer.paypal.com/dashboard/applications/sandbox  (sandbox)
#   https://developer.paypal.com/dashboard/applications/live     (live)
# Create one app per environment; client id + secret never cross envs.
PAYPAL_CLIENT_ID=""
PAYPAL_SECRET=""

# Public client id, exposed to the browser via the PayPal JS SDK. This
# is fine to ship — it's the same value PayPal embeds in the buttons
# anyway. SAFE to share. The matching secret above stays server-only.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""

# ---------------------------------------------------------------------
# Local-dev geo override (development only)
# ---------------------------------------------------------------------
# Forces server-side locale + currency + language-toggle visibility to
# behave as if the visitor's IP resolved to this 2-letter ISO-3166
# country code. Useful when localhost has no geo header.
#   "BG" → Bulgarian locale, EUR pricing, language toggle visible
#   "US" → English locale,    USD pricing, no toggle
# Ignored when NODE_ENV=production.
# DEV_COUNTRY="BG"
