rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // PUBLIC CREATION (Website / Lead Generation)
    // ============================================

    // Survey responses from the website (public create; read for owner desktop monitor via same API key)
    match /survey_responses/{docId} {
      allow create: if 
        request.resource.data.email is string &&
        request.resource.data.email != "";
      allow read: if true;
      // Desktop monitor may update pipeline status only (not survey answers)
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['monitor_status'])
          && request.resource.data.monitor_status is string;
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['monitor_status', 'archived']);
      allow delete: if false;
    }

    // Marketing email subscribers
    match /marketing_emails/{docId} {
      allow create: if 
        request.resource.data.email is string &&
        request.resource.data.email != "";
      allow read: if true;
      allow update, delete: if false;
    }

    // ============================================
    // INTERNAL COLLECTIONS (Desktop App Only)
    // ============================================

    match /contacts/{docId} {
      allow create: if
        request.resource.data.email is string &&
        request.resource.data.email != "" &&
        request.resource.data.funnelStage is string;
      allow update: if
        request.resource.data.email is string &&
        request.resource.data.funnelStage is string;
      allow read: if true;
      allow delete: if false;
    }

    // Desktop monitor creates/updates journey side-effect records (REST API key)
    match /reports/{docId} {
      allow create: if
        request.resource.data.contactId is string &&
        request.resource.data.status is string;
      allow update: if
        request.resource.data.contactId is string &&
        request.resource.data.status is string;
      allow read: if true;
      allow delete: if false;
    }

    match /meetings/{docId} {
      allow create: if request.resource.data.contactId is string;
      allow update: if request.resource.data.contactId is string;
      allow read: if true;
      allow delete: if false;
    }

    match /proposals/{docId} {
      allow create: if request.resource.data.contactId is string;
      allow update: if request.resource.data.contactId is string;
      allow read: if true;
      allow delete: if false;
    }

    match /projects/{docId} {
      allow create: if request.resource.data.contactId is string;
      allow update: if request.resource.data.contactId is string;
      allow read: if true;
      allow delete: if false;
    }

    match /activities/{docId} {
      allow create: if
        request.resource.data.contactId is string &&
        request.resource.data.type is string;
      allow read: if true;
      allow update, delete: if false;
    }

    // Journey actions (tasks with due dates — created on website intake, updated by desktop)
    match /actions/{docId} {
      allow create: if
        request.resource.data.contactId is string &&
        request.resource.data.type is string &&
        request.resource.data.status is string &&
        request.resource.data.dueAt is string;
      allow update: if
        request.resource.data.contactId is string &&
        request.resource.data.status is string;
      allow read: if true;
      allow delete: if false;
    }

    // Outbound correspondence sent to clients (reports, marketing, proposals)
    match /sent_emails/{docId} {
      allow create: if
        request.resource.data.toEmail is string &&
        request.resource.data.subject is string &&
        request.resource.data.template is string &&
        request.resource.data.status is string;
      allow update: if
        request.resource.data.toEmail is string &&
        request.resource.data.status is string;
      allow read: if true;
      allow delete: if false;
    }

    // Orders (create + status updates allowed; read for owner desktop monitor)
    match /orders/{docId} {
      allow create: if 
        request.resource.data.customer is map &&
        request.resource.data.customer.email is string &&
        request.resource.data.status is string;

      allow update: if 
        request.resource.data.keys().hasAll(['status']) &&
        request.resource.data.status is string;

      allow read: if true;
      allow delete: if false;
    }

    // ============================================
    // TEST COLLECTIONS (Development)
    // ============================================

    match /survey_responses_test/{docId} {
      allow create: if true;
      allow read: if true;
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['monitor_status'])
          && request.resource.data.monitor_status is string;
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['monitor_status', 'archived']);
      allow delete: if false;
    }

    match /marketing_emails_test/{docId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if false;
    }

    match /contacts_test/{docId} {
      allow create, read, update: if true;
      allow delete: if false;
    }

    match /reports_test/{docId} {
      allow create, read, update: if true;
      allow delete: if false;
    }

    match /meetings_test/{docId} {
      allow create, read, update: if true;
      allow delete: if false;
    }

    match /proposals_test/{docId} {
      allow create, read, update: if true;
      allow delete: if false;
    }

    match /projects_test/{docId} {
      allow create, read, update: if true;
      allow delete: if false;
    }

    match /activities_test/{docId} {
      allow create, read, update: if true;
      allow delete: if false;
    }

    match /actions_test/{docId} {
      allow create, read, update: if true;
      allow delete: if false;
    }

    match /sent_emails_test/{docId} {
      allow create, read, update: if true;
      allow delete: if false;
    }

    match /orders_test/{docId} {
      allow create: if true;
      allow read: if true;
      allow update: if 
        request.resource.data.keys().hasAll(['status']);
      allow delete: if false;
    }

    // Post-purchase KYC from conversion kit library (first login)
    match /conversion_kit_kyc/{docId} {
      allow create: if
        request.resource.data.email is string &&
        request.resource.data.business_type is string &&
        request.resource.data.desired_results is string &&
        request.resource.data.pain is string &&
        request.resource.data.tried_so_far is string &&
        request.resource.data.budget is string;
      allow update: if
        request.resource.data.email is string &&
        request.resource.data.business_type is string &&
        request.resource.data.desired_results is string &&
        request.resource.data.pain is string &&
        request.resource.data.tried_so_far is string &&
        request.resource.data.budget is string;
      allow read: if true;
      allow delete: if false;
    }

    match /conversion_kit_kyc_test/{docId} {
      allow create, read, update: if true;
      allow delete: if false;
    }

    // ============================================
    // DEFAULT DENY
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
