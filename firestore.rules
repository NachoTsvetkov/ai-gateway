rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // PUBLIC CREATION (Website / Lead Generation)
    // ============================================

    // Survey responses from the website (public create; read for owner desktop monitor via same API key)
    match /survey_responses/{docId} {
      allow create: if 
        request.resource.data.email is string &&
        request.resource.data.email != "";
      allow read: if true;
      allow update, delete: if false;
    }

    // Marketing email subscribers
    match /marketing_emails/{docId} {
      allow create: if 
        request.resource.data.email is string &&
        request.resource.data.email != "";
      allow read: if true;
      allow update, delete: if false;
    }

    // ============================================
    // INTERNAL COLLECTIONS (Desktop App Only)
    // ============================================

    match /contacts/{docId} {
      allow create: if
        request.resource.data.email is string &&
        request.resource.data.email != "" &&
        request.resource.data.funnelStage is string;
      allow update: if
        request.resource.data.email is string &&
        request.resource.data.funnelStage is string;
      allow read: if true;
      allow delete: if false;
    }

    match /reports/{docId} {
      allow read, write: if false;
    }

    match /meetings/{docId} {
      allow read, write: if false;
    }

    match /proposals/{docId} {
      allow read, write: if false;
    }

    match /projects/{docId} {
      allow read, write: if false;
    }

    match /activities/{docId} {
      allow create: if
        request.resource.data.contactId is string &&
        request.resource.data.type is string;
      allow read: if true;
      allow update, delete: if false;
    }

    // Journey actions (tasks with due dates — created on website intake, updated by desktop)
    match /actions/{docId} {
      allow create: if
        request.resource.data.contactId is string &&
        request.resource.data.type is string &&
        request.resource.data.status is string &&
        request.resource.data.dueAt is string;
      allow update: if
        request.resource.data.contactId is string &&
        request.resource.data.status is string;
      allow read: if true;
      allow delete: if false;
    }

    // Orders (create + status updates allowed; read for owner desktop monitor)
    match /orders/{docId} {
      allow create: if 
        request.resource.data.customer is map &&
        request.resource.data.customer.email is string &&
        request.resource.data.status is string;

      allow update: if 
        request.resource.data.keys().hasAll(['status']) &&
        request.resource.data.status is string;

      allow read: if true;
      allow delete: if false;
    }

    // ============================================
    // TEST COLLECTIONS (Development)
    // ============================================

    match /survey_responses_test/{docId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if false;
    }

    match /marketing_emails_test/{docId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if false;
    }

    match /contacts_test/{docId} {
      allow create, read, update: if true;
      allow delete: if false;
    }

    match /reports_test/{docId} {
      allow create, read, update: if true;
      allow delete: if false;
    }

    match /meetings_test/{docId} {
      allow create, read, update: if true;
      allow delete: if false;
    }

    match /proposals_test/{docId} {
      allow create, read, update: if true;
      allow delete: if false;
    }

    match /projects_test/{docId} {
      allow create, read, update: if true;
      allow delete: if false;
    }

    match /activities_test/{docId} {
      allow create, read, update: if true;
      allow delete: if false;
    }

    match /actions_test/{docId} {
      allow create, read, update: if true;
      allow delete: if false;
    }

    match /orders_test/{docId} {
      allow create: if true;
      allow read: if true;
      allow update: if 
        request.resource.data.keys().hasAll(['status']);
      allow delete: if false;
    }

    // ============================================
    // DEFAULT DENY
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
